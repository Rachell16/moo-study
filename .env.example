# Salin jadi .env (jangan di-commit), lalu isi dari Supabase: Project Settings > API.
# Server (jangan pakai awalan VITE_ untuk yang rahasia)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser (nilainya sama dengan dua di atas; kunci publishable memang publik)
VITE_SUPABASE_URL=https://XXXX.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Calendar (opsional, lihat README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIMEZONE=Asia/Jakarta

# Fitur AI ruang belajar (opsional, gratis): kunci dari https://aistudio.google.com > Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash   # ganti kalau modelnya berubah; pakai model Flash yang gratis
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest   # dicoba kalau model utama sibuk atau kena batas (pisahkan dengan koma)
# GEMINI_THINKING_LEVEL=medium   # bawaan untuk model seri 3 (dipilih per permintaan lewat Cepat/Seimbang/Teliti di aplikasi); GEMINI_THINKING=off untuk mematikan

# Batas pemakaian AI per hari (jatah gratis Gemini project ini 20 per hari, jadi sisakan sedikit untuk percobaan manual)
# AI_DAILY_LIMIT_PER_USER=8
# AI_DAILY_LIMIT_GLOBAL=18
# AI_RESET_TZ=America/Los_Angeles   # zona waktu reset harian Google (tengah malam Pasifik)

# Melindungi /api/keepalive supaya hanya Vercel Cron yang bisa memanggilnya (opsional tapi disarankan)
# CRON_SECRET=
